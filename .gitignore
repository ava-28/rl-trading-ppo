# Environments
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# Cached market data — regenerable, and large
data/cache_v2/
data/cache/
*.parquet

# Model checkpoints — 12 MB of binaries, no value to a reader
checkpoints/
checkpoints_*/
results_*/checkpoints/
*.pt
*.pth
*.pkl

# Bulky per-seed run artefacts
results_*/equity_curves/
results_*/trade_logs/
results_*/*.log

# Logs
*.log
nohup.out

# Secrets — never commit
.env
.env.*
secrets.yaml
*_key.txt

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# results_v3 was produced by two invocations (a crashed 27-run suite, then a
# 5-run completion), so its auto-generated summary files describe only the
# final invocation and would mislead a reader. The authoritative merged data
# is results_v3/metrics_complete.csv, built from both. Ignore the partials.
results_v3/metrics_raw.csv
results_v3/metrics_summary.json
results_v3/ablation_table.csv
results_v3/metrics_recovered_from_log.csv
results_v3/plots/

# ---------------------------------------------------------------------------
# Keep the headline results. These are small and the README links them.
# ---------------------------------------------------------------------------
!results_v3/metrics_complete.csv
!results_v3/summary_30runs.png
!results_primary/plots/
!results_primary/plots/*.png
!results_primary/metrics_summary.json
!results_primary/metrics_raw.csv
!results_primary/ablation_table.csv
